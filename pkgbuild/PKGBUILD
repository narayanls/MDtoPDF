# Maintainer: Narayan Lima da Silva <narayan.song@gmail.com>

pkgname=md-to-pdf
# A versão vem de APP_VERSION (usr/share/md-to-pdf/core/__init__.py), para o
# pacote e o app nunca ficarem com números diferentes.
pkgver=$(sed -n 's/^APP_VERSION = "\(.*\)"/\1/p' "${startdir:-.}/../usr/share/md-to-pdf/core/__init__.py")
pkgrel=1
pkgdesc="Lê arquivos Markdown e exporta o conteúdo formatado em PDF (GTK 4)"
arch=('any')
url="https://github.com/narayanls/MDtoPDF"
license=('GPL-3.0-or-later')
depends=(
    'python'
    'python-gobject'
    'python-cairo'
    'gtk4'
    'libadwaita'
    'poppler-glib'
    'python-weasyprint'
    'python-markdown-it-py'
    'python-mdit_py_plugins'
    'python-pygments'
)
makedepends=('gettext')
optdepends=(
    'python-linkify-it-py: transforma URLs soltas no texto em links'
    'noto-fonts: fontes usadas pelos estilos do PDF'
    'noto-fonts-emoji: emojis coloridos no PDF'
)
source=()
sha256sums=()

# Empacota a árvore usr/ que está ao lado desta pasta (MDtoPDF/usr).
# Uso: cd pkgbuild && makepkg -si
package() {
    local root="$startdir/.."
    local src="$root/usr"

    # Copia tudo, ignorando caches de bytecode e traduções compiladas em desenvolvimento
    (cd "$src" && find . -type f ! -path '*/__pycache__/*' ! -name '*.pyc' ! -name '*.mo') |
    while IFS= read -r file; do
        install -Dm644 "$src/$file" "$pkgdir/usr/$file"
    done

    chmod 755 "$pkgdir/usr/bin/$pkgname"

    # Compila as traduções (po/*.po → /usr/share/locale/<idioma>/LC_MESSAGES/*.mo)
    local po lang
    for po in "$root"/po/*.po; do
        lang=$(basename "$po" .po)
        install -dm755 "$pkgdir/usr/share/locale/$lang/LC_MESSAGES"
        msgfmt --check -o "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/$pkgname.mo" "$po"
    done

    install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$root/README.en.md" "$pkgdir/usr/share/doc/$pkgname/README.en.md"
    install -Dm644 "$root/examples/demo.md" "$pkgdir/usr/share/doc/$pkgname/examples/demo.md"

    # Pré-compila o bytecode com os caminhos finais
    python -m compileall -q -d "/usr/share/$pkgname" "$pkgdir/usr/share/$pkgname"
}
